local function refreshHistoryToggleUI()
	if isHistoryBased then
		toggleBtn.BackgroundColor3 = THEME.ACCENT
		toggleBtn.TextColor3 = THEME.BG
		toggleBtn.Text = "ON"
	else
		toggleBtn.BackgroundColor3 = THEME.BG_CARD
		toggleBtn.TextColor3 = THEME.TEXT_MUTED
		toggleBtn.Text = "OFF"
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	isHistoryBased = not isHistoryBased
	refreshHistoryToggleUI()
	saveConfig()
end)

