local tabs = {
	{ id = "Predictor", icon = "🎲", label = "Predictor", w = 82, x = 3 },
	{ id = "History",   icon = "📜", label = "History",   w = 82, x = 88 },
	{ id = "Settings",  icon = "⚙️", label = "Settings",  w = 82, x = 173 },
}

local tabBtnObjects = {}
local tabPages = {}

local function switchTab(tabId)
	activeTab = tabId
	for _, t in ipairs(tabs) do
		local page = tabPages[t.id]
		local btn = tabBtnObjects[t.id]
		if t.id == tabId then
			if page then page.Visible = true end
			if btn then
				btn.TextColor3 = THEME.ACCENT
			end
			tween(tabGlider, 0.22, {
				Position = UDim2.fromOffset(t.x, 3),
				Size = UDim2.fromOffset(t.w, 24),
			}, Enum.EasingStyle.Quart)
		else
			if page then page.Visible = false end
			if btn then
				btn.TextColor3 = THEME.TEXT_DIM
			end
		end
	end
end

for _, tabInfo in ipairs(tabs) do
	local btn = button({
		Position = UDim2.fromOffset(tabInfo.x, 3),
		Size = UDim2.fromOffset(tabInfo.w, 24),
		BackgroundTransparency = 1,
		Text = tabInfo.icon .. " " .. tabInfo.label,
		TextColor3 = (tabInfo.id == activeTab and THEME.ACCENT) or THEME.TEXT_DIM,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		ZIndex = 6,
	}, tabButtonsContainer)

	btn.MouseButton1Click:Connect(function()
		switchTab(tabInfo.id)
	end)
	tabBtnObjects[tabInfo.id] = btn
end

