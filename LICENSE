-- Save position debounced on movement
local lastSavePos = 0
frame:GetPropertyChangedSignal("Position"):Connect(function()
	local now = tick()
	if now - lastSavePos > 0.8 then
		lastSavePos = now
		task.delay(0.5, function()
			saveConfig()
		end)
	end
end)

