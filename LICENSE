-- ================= MINIMIZE & EXPAND ===================
collapseBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	popupOverlay.Visible = false
	activeSlotIndex = nil

	if isMinimized then
		body.Visible = false
		tabButtonsContainer.Visible = false
		infoBtn.Visible = false
		collapseBtn.Text = "+"
		collapseBtn.TextColor3 = THEME.ACCENT

		frameCorner.CornerRadius = UDim.new(0, 21)
		headerCorner.CornerRadius = UDim.new(0, 21)
		bgImageCorner.CornerRadius = UDim.new(0, 21)

		tween(frame, 0.35, { Size = UDim2.fromOffset(MINI_W, MINI_H) }, Enum.EasingStyle.Quart)
	else
		collapseBtn.Text = "-"
		collapseBtn.TextColor3 = THEME.TEXT_DIM

		local tw = tween(frame, 0.35, { Size = UDim2.fromOffset(BASE_W, BASE_H) }, Enum.EasingStyle.Quart)
		tw.Completed:Connect(function()
			if not isMinimized then
				frameCorner.CornerRadius = UDim.new(0, 26)
				headerCorner.CornerRadius = UDim.new(0, 26)
				bgImageCorner.CornerRadius = UDim.new(0, 26)
				body.Visible = true
				tabButtonsContainer.Visible = true
				infoBtn.Visible = true
				switchTab(activeTab)
			end
		end)
	end
end)

-- ================= PREDICT ACTION =======================
-- Rule:
-- 1. Does NOT add the predicted color into history!
-- 2. Adds the 4 colors entered by user into history when Predict is pressed!
-- 3. Calculates the real mathematical odds of what comes next.
spinBtn.MouseButton1Click:Connect(function()
	if isBusy then return end
	isBusy = true
	popupOverlay.Visible = false
	activeSlotIndex = nil

	task.spawn(function()
		local ok, err = pcall(function()
			spinBtn.Text = "🎲 ANALYZING 4-DICE PATTERNS..."
			predictedTitle.Text = "CALCULATING..."
			predictedTitle.TextColor3 = THEME.TEXT_DIM
			secTitle.Text = "CALCULATING..."
			bigDieStroke.Color = THEME.BORDER_HIGH
			secDieStroke.Color = THEME.BORDER_HIGH
			confText.Text = "⭐ Main: ..."
			secConfText.Text = "🛡️ Backup: ..."

			-- LOG USER'S ENTERED 4 SLOTS INTO HISTORY
			local enteredRound = {
				currentSlots[1] or "Yellow",
				currentSlots[2] or "Yellow",
				currentSlots[3] or "Blue",
				currentSlots[4] or "Yellow"
			}
			table.insert(sessionHistory, enteredRound)
			refreshHistoryUI()

			-- Calculate deep prediction using Online-Dice 4D Engine
			local pred1, conf1, patDesc, allPct, pred2, conf2, duoConf, pred4 = calculateRealOdds(currentSlots)

			-- Rolling Animation
			for s = 1, 14 do
				local r1 = KEYS[math.random(#KEYS)]
				local r2 = KEYS[math.random(#KEYS)]
				bigDie.BackgroundColor3 = COLORS[r1]
				bigDieText.Text = r1:sub(1, 1)
				secDie.BackgroundColor3 = COLORS[r2]
				secDieText.Text = r2:sub(1, 1)

				for p = 1, 4 do
					local rp = KEYS[math.random(#KEYS)]
					pred4Chips[p].dot.BackgroundColor3 = COLORS[rp]
					pred4Chips[p].lbl.Text = rp:sub(1, 3):upper()
				end
				task.wait(0.02 + s * 0.009)
			end

			-- Display Primary Target #1
			bigDie.BackgroundColor3 = COLORS[pred1] or COLORS.Yellow
			bigDieStroke.Color = COLORS[pred1] or COLORS.Yellow
			bigDieText.Text = pred1:sub(1, 1)
			predictedTitle.Text = "1ST: " .. pred1:upper()
			predictedTitle.TextColor3 = COLORS[pred1] or COLORS.Yellow
			confText.Text = "⭐ Main: " .. tostring(conf1) .. "%"

			-- Display Secondary Target #2
			secDie.BackgroundColor3 = COLORS[pred2] or COLORS.Blue
			secDieStroke.Color = COLORS[pred2] or COLORS.Blue
			secDieText.Text = pred2:sub(1, 1)
			secTitle.Text = "2ND: " .. pred2:upper()
			secTitle.TextColor3 = COLORS[pred2] or COLORS.Blue
			secConfText.Text = "🛡️ Backup: " .. tostring(conf2) .. "%"

			-- Display Duo Combined Accuracy
			duoBadge.Text = "Duo Hit Rate: ~" .. tostring(duoConf) .. "%"

			-- Display Predicted 4-Dice Spread
			for p = 1, 4 do
				local cName = pred4[p] or KEYS[p]
				pred4Chips[p].dot.BackgroundColor3 = COLORS[cName]
				pred4Chips[p].lbl.Text = cName:sub(1, 3):upper()
				pred4Chips[p].lbl.TextColor3 = THEME.TEXT
			end

			patternBadge.Text = "📌 Pattern: " .. tostring(patDesc)

			tween(bigDie, 0.15, { Size = UDim2.fromOffset(50, 50) })
			task.wait(0.15)
			tween(bigDie, 0.2, { Size = UDim2.fromOffset(46, 46) })
		end)

		if not ok then
			warn("Viper Prediction Error: ", err)
			predictedTitle.Text = "READY"
		end

		spinBtn.Text = "⚡ PREDICT NEXT COLOR"
		isBusy = false
	end)
end)

-- Initialize UI State
refreshSlotsUI()
refreshHistoryUI()
refreshHistoryToggleUI()
switchTab("Predictor")
