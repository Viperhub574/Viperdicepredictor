	SortOrder = Enum.SortOrder.LayoutOrder,
}, historyScroll)

local function refreshHistoryUI()
	for _, c in ipairs(historyScroll:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end

	local count = #sessionHistory
	countLabel.Text = count .. " Rolls"
	historyScroll.CanvasSize = UDim2.fromOffset(0, count * 34)

	for idx = count, 1, -1 do
		local round = sessionHistory[idx]
		local item = make("Frame", {
			Size = UDim2.fromOffset(196, 28),
			BackgroundColor3 = THEME.BG_CARD,
			LayoutOrder = -idx,
			ZIndex = 5,
		}, historyScroll)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, item)
		make("UIStroke", { Color = THEME.BORDER, Thickness = 1 }, item)

		label({
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(28, 16),
			Text = "#" .. idx,
			Font = Enum.Font.GothamBold,
			TextSize = 9,
			TextColor3 = THEME.TEXT_MUTED,
			ZIndex = 6,
		}, item)

		local dotsHolder = make("Frame", {
			Position = UDim2.fromOffset(38, 5),
			Size = UDim2.fromOffset(150, 18),
			BackgroundTransparency = 1,
			ZIndex = 6,
		}, item)

		for s = 1, 4 do
			local colName = round[s]
			local dot = make("Frame", {
				Position = UDim2.fromOffset((s - 1) * 36, 1),
				Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = COLORS[colName] or THEME.BORDER,
				ZIndex = 7,
			}, dotsHolder)
			make("UICorner", { CornerRadius = UDim.new(0, 8) }, dot)

			label({
				Position = UDim2.fromOffset((s - 1) * 36 + 18, 1),
				Size = UDim2.fromOffset(16, 16),
				Text = colName:sub(1, 1),
				Font = Enum.Font.GothamBold,
				TextSize = 8,
				TextColor3 = THEME.TEXT,
				ZIndex = 7,
			}, dotsHolder)
		end
	end
end

clearHistBtn.MouseButton1Click:Connect(function()
	sessionHistory = {}
	refreshHistoryUI()
end)

delLastHistBtn.MouseButton1Click:Connect(function()
	if #sessionHistory > 0 then
		table.remove(sessionHistory, #sessionHistory)
		refreshHistoryUI()
	end
end)

