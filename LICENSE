local function buildFaqItem(qProp, aProp, order)
	local box = make("Frame", {
		ZIndex = 28,
		Size = UDim2.new(1, -6, 0, 80),
		BackgroundColor3 = THEME.BG_CARD,
		LayoutOrder = order,
	}, infoScroll)
	make("UICorner", { CornerRadius = UDim.new(0, 14) }, box)
	make("UIStroke", { Color = THEME.BORDER, Thickness = 1 }, box)

	local qLbl = label({
		ZIndex = 29,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Text = qProp,
		TextColor3 = THEME.ACCENT,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
	}, box)

	local aLbl = label({
		ZIndex = 29,
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 46),
		Text = aProp,
		TextColor3 = THEME.TEXT,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, box)

	return qLbl, aLbl
end

local q1Lbl, a1Lbl = buildFaqItem("", "", 1)
local q2Lbl, a2Lbl = buildFaqItem("", "", 2)
local q3Lbl, a3Lbl = buildFaqItem("", "", 3)
local q4Lbl, a4Lbl = buildFaqItem("", "", 4)

local function refreshInfoLanguage()
	local t = INFO_TEXTS[currentLang] or INFO_TEXTS.EN
	langBtn.Text = t.btn
	infoTitle.Text = "❓ " .. t.title
	q1Lbl.Text = t.q1
	a1Lbl.Text = t.a1
	q2Lbl.Text = t.q2
	a2Lbl.Text = t.a2
	q3Lbl.Text = t.q3
	a3Lbl.Text = t.a3
	q4Lbl.Text = t.q4
	a4Lbl.Text = t.a4
end

langBtn.MouseButton1Click:Connect(function()
	if currentLang == "EN" then
		currentLang = "TR"
	elseif currentLang == "TR" then
		currentLang = "RU"
	else
		currentLang = "EN"
	end
	refreshInfoLanguage()
	saveConfig()
end)

refreshInfoLanguage()

