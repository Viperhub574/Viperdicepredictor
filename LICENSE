label({
	Position = UDim2.fromOffset(16, 10),
	Size = UDim2.fromOffset(300, 16),
	Text = "🖼️ CUSTOM WALLPAPERS",
	Font = Enum.Font.GothamBold,
	TextSize = 10,
	TextColor3 = THEME.TEXT,
}, bgSection)

local bgCards = {}
local function updateBgCardsBorder()
	for _, b in ipairs(bgCards) do
		if b.asset == currentBgAsset then
			b.stroke.Color = THEME.ACCENT
			b.stroke.Thickness = 2
		else
			b.stroke.Color = THEME.BORDER
			b.stroke.Thickness = 1
		end
	end
end

for i, asset in ipairs(BG_ASSETS) do
	local bgCard = button({
		Position = UDim2.fromOffset(16 + (i - 1) * 115, 32),
		Size = UDim2.fromOffset(105, 72),
		BackgroundColor3 = THEME.BG_CARD,
		ZIndex = 3,
	}, bgSection)
	make("UICorner", { CornerRadius = UDim.new(0, 14) }, bgCard)
	local bStroke = make("UIStroke", {
		Color = (asset == currentBgAsset and THEME.ACCENT) or THEME.BORDER,
		Thickness = (asset == currentBgAsset and 2) or 1,
	}, bgCard)

	local previewImg = make("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = asset,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 4,
	}, bgCard)
	make("UICorner", { CornerRadius = UDim.new(0, 14) }, previewImg)

	bgCards[i] = { btn = bgCard, stroke = bStroke, asset = asset }

	bgCard.MouseButton1Click:Connect(function()
		currentBgAsset = asset
		bgImage.Image = asset
		tween(bgImage, 0.45, { ImageTransparency = 0.18 })
		updateBgCardsBorder()
		saveConfig()
	end)
end

local removeBgBtn = button({
	Position = UDim2.fromOffset(366, 42),
	Size = UDim2.fromOffset(160, 48),
	BackgroundColor3 = THEME.BG_CARD,
	Text = "Remove Background",
	TextColor3 = THEME.DANGER,
	Font = Enum.Font.GothamBold,
	TextSize = 10,
	ZIndex = 3,
}, bgSection)
make("UICorner", { CornerRadius = UDim.new(0, 14) }, removeBgBtn)
make("UIStroke", { Color = THEME.DANGER, Thickness = 1 }, removeBgBtn)

removeBgBtn.MouseButton1Click:Connect(function()
	currentBgAsset = nil
	tween(bgImage, 0.35, { ImageTransparency = 1 })
	task.wait(0.35)
	if not currentBgAsset then bgImage.Image = "" end
	updateBgCardsBorder()
	saveConfig()
end)

