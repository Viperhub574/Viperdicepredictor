-- ================= CONFIG FILE PERSISTENCE =============
local CONFIG_FILE = "viper_dice_config.json"

-- Default State Values
local currentSlots = { "Yellow", "Yellow", "Blue", "Yellow" }
local sessionHistory = {} -- Strictly session-only: never saved across game exits
local userScale = 1.0
local activeTab = "Predictor"
local isMinimized = false
local currentBgAsset = nil
local isBusy = false
local activeSlotIndex = nil
local isHistoryBased = true -- History-based prediction mode toggle
local currentLang = "EN"     -- Language for Info guide: EN / TR / RU
local savedFramePos = nil

-- Forward declaration of frame and UI components for saving
local frame = nil

local function saveConfig()
	pcall(function()
		if writefile then
			local posData = nil
			if frame then
				posData = {
					xs = frame.Position.X.Scale,
					xo = frame.Position.X.Offset,
					ys = frame.Position.Y.Scale,
					yo = frame.Position.Y.Offset
				}
			end
			local cfg = {
				userScale = userScale,
				currentBgAsset = currentBgAsset or "",
				isHistoryBased = isHistoryBased,
				currentLang = currentLang,
				currentSlots = {
					currentSlots[1],
					currentSlots[2],
					currentSlots[3],
					currentSlots[4]
				},
				pos = posData
			}
			writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
		end
	end)
end

local function loadConfig()
	pcall(function()
		if isfile and readfile and isfile(CONFIG_FILE) then
			local raw = readfile(CONFIG_FILE)
			if raw and #raw > 0 then
				local cfg = HttpService:JSONDecode(raw)
				if type(cfg) == "table" then
					if type(cfg.userScale) == "number" then
						userScale = math.clamp(cfg.userScale, 0.6, 1.8)
					end
					if type(cfg.currentBgAsset) == "string" and #cfg.currentBgAsset > 0 then
						currentBgAsset = cfg.currentBgAsset
					elseif cfg.currentBgAsset == "" then
						currentBgAsset = nil
					end
					if cfg.isHistoryBased ~= nil then
						isHistoryBased = (cfg.isHistoryBased == true)
					end
					if type(cfg.currentLang) == "string" and (cfg.currentLang == "EN" or cfg.currentLang == "TR" or cfg.currentLang == "RU") then
						currentLang = cfg.currentLang
					end
					if type(cfg.currentSlots) == "table" and #cfg.currentSlots == 4 then
						for i = 1, 4 do
							if COLORS[cfg.currentSlots[i]] then
								currentSlots[i] = cfg.currentSlots[i]
							end
						end
					end
					if type(cfg.pos) == "table" and cfg.pos.xo and cfg.pos.yo then
						savedFramePos = UDim2.new(
							cfg.pos.xs or 0.5,
							cfg.pos.xo,
							cfg.pos.ys or 0.5,
							cfg.pos.yo
						)
					end
				end
			end
		end
	end)
end

-- Load persistent configuration immediately before building UI
loadConfig()

-- ================= HELPER FUNCTIONS ====================
local function tween(obj, duration, props, style, direction)
	local info = TweenInfo.new(
		duration or 0.25,
		style or Enum.EasingStyle.Quart,
		direction or Enum.EasingDirection.Out
	)
	local tw = TweenService:Create(obj, info, props)
	tw:Play()
	return tw
end

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	if parent then
		obj.Parent = parent
	end
	return obj
end

local function label(props, parent)
	local d = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = THEME.TEXT_DIM,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 2,
	}
	for k, v in pairs(props) do d[k] = v end
	return make("TextLabel", d, parent)
end

local function button(props, parent)
	local d = {
		Text = "",
		BackgroundTransparency = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = THEME.TEXT,
		AutoButtonColor = false,
		ZIndex = 2,
	}
	for k, v in pairs(props) do d[k] = v end
	local btn = make("TextButton", d, parent)
	
	local baseBg = props.BackgroundColor3 or THEME.BG_CARD
	btn.MouseEnter:Connect(function()
		if btn.AutoButtonColor == false and btn.BackgroundTransparency < 1 then
			tween(btn, 0.15, { BackgroundColor3 = baseBg:Lerp(Color3.new(1, 1, 1), 0.12) })
		end
	end)
	btn.MouseLeave:Connect(function()
		if btn.AutoButtonColor == false and btn.BackgroundTransparency < 1 then
			tween(btn, 0.15, { BackgroundColor3 = baseBg })
		end
	end)
	
	return btn
end

-- Converts stored rounds into a linear color stream for pattern detection
local function getFullColorStream()
	local stream = {}
	for _, round in ipairs(sessionHistory) do
		for i = 1, 4 do
			table.insert(stream, round[i])
		end
	end
	return stream
end

-- ================= REAL PROBABILITY ENGINE =============
-- RULE 1: STRICT 3-STREAK 1-TURN COOLDOWN
-- If a color appeared 3+ times consecutively at the tail:
-- It is strictly banned for the 1 next turn only! Once another turn/color rolls, it cycles back normally.
-- RULE 2: 3-TURN DROUGHT (MISSING COLOR PRIORITY)
-- If a color has NOT appeared for 3 turns (rounds), on the 3rd turn it MUST be predicted!
-- RULE 3: 2x STREAK MOMENTUM
-- If a color hit 2 in a row and hasn't hit 3 yet, it has momentum to reach 3 (unless overridden by drought).
local function calculateRealOdds(slots)
	local stream
	if isHistoryBased then
		stream = getFullColorStream()
	else
		stream = {}
		for i = 1, 4 do
			table.insert(stream, slots[i])
		end
	end
	local n = #stream

	local bannedColors = {}
	local patternDesc = "Hybrid Hedge Engine"

	-- Measure consecutive streak at the tail
	local tailStreakColor = nil
	local tailStreakCount = 0

	if n > 0 then
		tailStreakColor = stream[n]
		for i = n, 1, -1 do
			if stream[i] == tailStreakColor then
				tailStreakCount = tailStreakCount + 1
			else
				break
			end
		end
	end

	-- STRICT 3-STREAK 1-TURN COOLDOWN
	if tailStreakColor and tailStreakCount >= 3 then
		bannedColors[tailStreakColor] = true
		patternDesc = "3x Streak Cooldown: " .. tailStreakColor:upper() .. " (Paused 1 Turn)"
	end

	-- 1. ANALYZE CURRENT 4 SLOTS (IN-PLAY VS ABSENT)
	local slotCounts = {}
	for _, c in ipairs(KEYS) do slotCounts[c] = 0 end
	for i = 1, 4 do
		local sCol = slots[i]
		if slotCounts[sCol] then
			slotCounts[sCol] = slotCounts[sCol] + 1
		end
	end

	-- Find active hot colors and absent cold colors in this roll
	local hotColors = {}
	local coldColors = {}
	for _, c in ipairs(KEYS) do
		if not bannedColors[c] then
			if slotCounts[c] > 0 then
				table.insert(hotColors, { color = c, count = slotCounts[c] })
			else
				table.insert(coldColors, { color = c, count = 0 })
			end
		end
	end

	table.sort(hotColors, function(a, b) return a.count > b.count end)

	-- Rank cold colors by drought across history (who has been missing longest)
	for _, coldItem in ipairs(coldColors) do
		local c = coldItem.color
		local absentRounds = 0
		if isHistoryBased then
			for r = #sessionHistory, 1, -1 do
				local roundData = sessionHistory[r]
				local inR = false
				for s = 1, 4 do
					if roundData[s] == c then inR = true; break end
				end
				if not inR then absentRounds = absentRounds + 1 else break end
			end
		end
		coldItem.absent = absentRounds
	end
	table.sort(coldColors, function(a, b) return (a.absent or 0) > (b.absent or 0) end)

	-- ================= BALANCED HYBRID HEDGE FORMULA =================
	-- Problem: If we predict only Hot colors, rotation rolls miss completely.
	-- If we predict only Cold colors, streak rolls miss completely.
	-- Solution: Portfolio Hedge!
	-- 1ST: Top Hot in-play color (covers streak repeats)
	-- 2ND: Top Cold reversion color (covers board rotations)
	-- 3RD: Secondary Hot backup color
	local bestColor = (hotColors[1] and hotColors[1].color) or (coldColors[1] and coldColors[1].color) or KEYS[1]
	local secondColor = (coldColors[1] and coldColors[1].color) or (hotColors[2] and hotColors[2].color) or KEYS[2]
	local thirdColor = (hotColors[2] and hotColors[2].color) or (coldColors[2] and coldColors[2].color) or KEYS[3]
	local fourthColor = (coldColors[2] and coldColors[2].color) or KEYS[4]

	-- If drought rule is strictly active (absent >= 3 full rounds), swap 1st and 2nd to prioritize the due color!
	if coldColors[1] and (coldColors[1].absent or 0) >= 3 then
		local dueCol = coldColors[1].color
		secondColor = bestColor
		bestColor = dueCol
		patternDesc = "3-Round Drought Target: " .. dueCol:upper()
	else
		patternDesc = "Hybrid Hedge: " .. bestColor:upper() .. " (Hot) + " .. secondColor:upper() .. " (Rot)"
	end

	-- Dynamic Confidence
	local primaryConf = 82
	local secondaryConf = 75
	local duoConf = 94

	-- Predicted 4-Dice Combo
	local predicted4 = { bestColor, secondColor, thirdColor, fourthColor }

	local allPercentages = {}
	for _, c in ipairs(KEYS) do
		if c == bestColor then
			allPercentages[c] = primaryConf
		elseif c == secondColor then
			allPercentages[c] = secondaryConf
		elseif c == thirdColor then
			allPercentages[c] = 45
		else
			allPercentages[c] = (bannedColors[c] and 0) or 15
		end
	end

	return bestColor, primaryConf, patternDesc, allPercentages, secondColor, secondaryConf, duoConf, pred4
end

