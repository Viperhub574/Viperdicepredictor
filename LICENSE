local histPageScroll = make("ScrollingFrame", {
	Position = UDim2.fromOffset(18, 38),
	Size = UDim2.new(1, -36, 1, -48),
	BackgroundTransparency = 1,
	ScrollBarThickness = 4,
	ScrollBarImageColor3 = THEME.ACCENT,
	CanvasSize = UDim2.fromOffset(0, 0),
	ZIndex = 4,
}, histPageScroll)

local histPageList = make("UIListLayout", {
	Padding = UDim.new(0, 6),
	SortOrder = Enum.SortOrder.LayoutOrder,
}, histPageScroll)

local function refreshDetailedHistory()
	for _, c in ipairs(histPageScroll:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end

	local count = #sessionHistory
	histPageScroll.CanvasSize = UDim2.fromOffset(0, count * 36)

	for idx = count, 1, -1 do
		local round = sessionHistory[idx]
		local row = make("Frame", {
			Size = UDim2.new(1, -8, 0, 30),
			BackgroundColor3 = THEME.BG_CARD,
			LayoutOrder = -idx,
			ZIndex = 5,
		}, histPageScroll)
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, row)
		make("UIStroke", { Color = THEME.BORDER, Thickness = 1 }, row)

		label({
			Position = UDim2.fromOffset(12, 7),
			Size = UDim2.fromOffset(60, 16),
			Text = "ROUND #" .. idx,
			Font = Enum.Font.GothamBold,
			TextSize = 9,
			TextColor3 = THEME.TEXT_MUTED,
			ZIndex = 6,
		}, row)

		for s = 1, 4 do
			local cName = round[s]
			local dot = make("Frame", {
				Position = UDim2.fromOffset(80 + (s - 1) * 110, 7),
				Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = COLORS[cName],
				ZIndex = 6,
			}, row)
			make("UICorner", { CornerRadius = UDim.new(0, 8) }, dot)

			label({
				Position = UDim2.fromOffset(102 + (s - 1) * 110, 7),
				Size = UDim2.fromOffset(80, 16),
				Text = cName:upper(),
				Font = Enum.Font.GothamBold,
				TextSize = 9,
				TextColor3 = THEME.TEXT,
				ZIndex = 6,
			}, row)
		end
	end
end

